{
  "name": "do-it-right-now",
  "version": "1.1.0",
  "type": "module",
  "description": "A modern todo desktop application built with Electron, React, and TypeScript",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"vite build --watch\" \"wait-on dist/main/main.js && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/browser": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^25.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.2",
    "playwright": "^1.59.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.do-it-right-now.app",
    "productName": "Do It Right Now",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "classic-level": "^3.0.0",
    "encoding": "^0.1.13",
    "idb": "^8.0.3",
    "leveldown": "^6.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^5.0.12"
  }
}
